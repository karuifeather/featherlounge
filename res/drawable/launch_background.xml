<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 launch window: the feather mark on the brand colour (Android 12+ uses the system splash, see values-v31). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item android:width="320px" android:height="320px" android:gravity="center">
        <bitmap android:src="@drawable/launch_feather" android:gravity="fill" />
    </item>
</layer-list>
